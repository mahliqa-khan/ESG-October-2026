  "topics": [
    {
      "id": "ghg", "pillar": "E", "name": "Climate & GHG Emissions",
      "relevance": { "manufacturing": 5, "energy": 5, "financials": 3, "software": 2, "retail": 3, "realestate": 4, "healthcare": 2, "logistics": 5 },
      "questions": [
        { "id": "ghg-1", "text": "Does the company have a climate policy and a board-level owner for emissions?", "weight": 1, "ref": "ISSB S2 / SASB" },
        { "id": "ghg-2", "text": "Are Scope 1 and 2 emissions measured, and is Scope 3 assessed for material categories?", "weight": 1.5, "ref": "GHG Protocol" },
        { "id": "ghg-3", "text": "Are emissions targets set with a baseline year, and progress independently verified?", "weight": 2, "ref": "SBTi criteria" },
        { "id": "ghg-data", "text": "Report Scope 1 and 2 emissions (tCO2e) for the latest period", "type": "number", "unit": "tCO2e", "scored": false }
      ]
    },
    {
      "id": "energy", "pillar": "E", "name": "Energy Management",
      "relevance": { "manufacturing": 4, "energy": 5, "financials": 2, "software": 3, "retail": 3, "realestate": 4, "healthcare": 3, "logistics": 4 },
      "questions": [
        { "id": "energy-1", "text": "Is there a policy on energy efficiency and renewable sourcing?", "weight": 1, "ref": "SASB" },
        { "id": "energy-2", "text": "Is energy consumption measured and tracked by site or business unit?", "weight": 1.5, "ref": "SASB" },
        { "id": "energy-3", "text": "Are renewable-energy targets time-bound and reported against?", "weight": 2, "ref": "SASB" }
      ]
    },
    {
      "id": "water-waste", "pillar": "E", "name": "Water, Waste & Circularity",
      "relevance": { "manufacturing": 4, "energy": 4, "financials": 1, "software": 1, "retail": 3, "realestate": 3, "healthcare": 3, "logistics": 3 },
      "questions": [
        { "id": "ww-1", "text": "Is there a policy covering water use, waste and circularity?", "weight": 1, "ref": "GRI 303 / 306" },
        { "id": "ww-2", "text": "Are water withdrawal, discharge and waste volumes measured?", "weight": 1.5, "ref": "GRI 303 / 306" },
        { "id": "ww-3", "text": "Are reduction or diversion targets set and tracked?", "weight": 2, "ref": "GRI 306" }
      ]
    },
    {
      "id": "biodiversity", "pillar": "E", "name": "Biodiversity & Land Use",
      "relevance": { "manufacturing": 2, "energy": 4, "financials": 1, "software": 1, "retail": 2, "realestate": 3, "healthcare": 1, "logistics": 2 },
      "questions": [
        { "id": "bio-1", "text": "Has the company assessed dependencies and impacts on nature at its sites?", "weight": 1, "ref": "TNFD" },
        { "id": "bio-2", "text": "Are high-biodiversity or protected areas screened before new operations?", "weight": 1.5, "ref": "TNFD" },
        { "id": "bio-3", "text": "Are nature-related commitments or restoration targets in place?", "weight": 2, "ref": "TNFD" }
      ]
    },
    {
      "id": "health-safety", "pillar": "S", "name": "Workforce Health & Safety",
      "relevance": { "manufacturing": 5, "energy": 5, "financials": 1, "software": 1, "retail": 3, "realestate": 4, "healthcare": 3, "logistics": 4 },
      "questions": [
        { "id": "hs-1", "text": "Is there a formal health and safety management system?", "weight": 1, "ref": "GRI 403" },
        { "id": "hs-2", "text": "Are incident rates and near-misses recorded and investigated?", "weight": 1.5, "ref": "GRI 403" },
        { "id": "hs-3", "text": "Are safety performance targets set and audited by a third party?", "weight": 2, "ref": "GRI 403" },
        { "id": "hs-data", "text": "Report lost-time injury rate per million hours worked", "type": "number", "unit": "per 1m hrs", "scored": false }
      ]
    },
    {
      "id": "labour-rights", "pillar": "S", "name": "Labour Practices & Human Rights",
      "relevance": { "manufacturing": 4, "energy": 3, "financials": 2, "software": 2, "retail": 4, "realestate": 3, "healthcare": 3, "logistics": 3 },
      "questions": [
        { "id": "lr-1", "text": "Is there a human rights or labour standards policy aligned to recognised conventions?", "weight": 1, "ref": "UNGP / GRI 407-409" },
        { "id": "lr-2", "text": "Are supply-chain labour risks assessed beyond tier one?", "weight": 1.5, "ref": "GRI 414" },
        { "id": "lr-3", "text": "Is there a grievance mechanism and are findings reported?", "weight": 2, "ref": "UNGP" }
      ]
    },
    {
      "id": "diversity", "pillar": "S", "name": "Diversity, Equity & Talent",
      "relevance": { "manufacturing": 3, "energy": 3, "financials": 4, "software": 4, "retail": 3, "realestate": 3, "healthcare": 3, "logistics": 3 },
      "questions": [
        { "id": "div-1", "text": "Is there a diversity and inclusion policy with named accountability?", "weight": 1, "ref": "GRI 405" },
        { "id": "div-2", "text": "Is workforce composition measured across levels and pay gaps analysed?", "weight": 1.5, "ref": "GRI 405-406" },
        { "id": "div-3", "text": "Are representation targets set with reported progress?", "weight": 2, "ref": "GRI 405" }
      ]
    },
    {
      "id": "product-safety", "pillar": "S", "name": "Product Safety & Quality",
      "relevance": { "manufacturing": 4, "energy": 3, "financials": 2, "software": 3, "retail": 4, "realestate": 2, "healthcare": 5, "logistics": 2 },
      "questions": [
        { "id": "ps-1", "text": "Is there a product quality and safety policy meeting applicable regulation?", "weight": 1, "ref": "SASB" },
        { "id": "ps-2", "text": "Are recalls, defects and customer complaints tracked?", "weight": 1.5, "ref": "SASB" },
        { "id": "ps-3", "text": "Is product safety independently certified or audited?", "weight": 2, "ref": "SASB" }
      ]
    },
    {
      "id": "board-oversight", "pillar": "G", "name": "Board Oversight & ESG Governance",
      "relevance": { "manufacturing": 4, "energy": 4, "financials": 4, "software": 3, "retail": 3, "realestate": 3, "healthcare": 3, "logistics": 3 },
      "questions": [
        { "id": "bo-1", "text": "Does the board have clear accountability for ESG oversight?", "weight": 1, "ref": "ISSB S1 / GRI 2" },
        { "id": "bo-2", "text": "Is ESG performance linked to executive remuneration?", "weight": 1.5, "ref": "GRI 2-19" },
        { "id": "bo-3", "text": "Is ESG reporting assured or reviewed externally?", "weight": 2, "ref": "ISSB S1" }
      ]
    },
    {
      "id": "business-ethics", "pillar": "G", "name": "Business Ethics & Anti-Corruption",
      "relevance": { "manufacturing": 4, "energy": 4, "financials": 4, "software": 3, "retail": 3, "realestate": 3, "healthcare": 3, "logistics": 3 },
      "questions": [
        { "id": "be-1", "text": "Is there a code of conduct and anti-bribery policy?", "weight": 1, "ref": "GRI 205" },
        { "id": "be-2", "text": "Are employees trained and are third parties screened?", "weight": 1.5, "ref": "GRI 205" },
        { "id": "be-3", "text": "Is there a confidential whistleblowing channel with reported outcomes?", "weight": 2, "ref": "GRI 2-26" }
      ]
    },
    {
      "id": "data-privacy", "pillar": "G", "name": "Data Privacy & Cybersecurity",
      "relevance": { "manufacturing": 3, "energy": 3, "financials": 5, "software": 5, "retail": 4, "realestate": 2, "healthcare": 4, "logistics": 2 },
      "questions": [
        { "id": "dp-1", "text": "Is there a data protection and cybersecurity policy?", "weight": 1, "ref": "SASB" },
        { "id": "dp-2", "text": "Are breaches, incidents and access controls monitored?", "weight": 1.5, "ref": "SASB" },
        { "id": "dp-3", "text": "Is the control environment independently tested or certified?", "weight": 2, "ref": "SASB / ISO 27001" }
      ]
    },
    {
      "id": "tax-transparency", "pillar": "G", "name": "Tax & Transparency",
      "relevance": { "manufacturing": 2, "energy": 3, "financials": 3, "software": 3, "retail": 2, "realestate": 2, "healthcare": 2, "logistics": 2 },
      "questions": [
        { "id": "tax-1", "text": "Is there a published tax policy and approach to tax governance?", "weight": 1, "ref": "GRI 207" },
        { "id": "tax-2", "text": "Is country-by-country tax contribution disclosed?", "weight": 1.5, "ref": "GRI 207-4" },
