  "id": "investor-esg-assessment",
  "name": "Investor ESG Assessment Framework",
  "version": "0.2.0",
  "description": "Configurable framework for investor firms to assess ESG risk and management maturity across portfolio companies. Everything here is data: edit this file to change topics, questions, sector weights or scoring bands without touching application code.",
  "scoreScale": { "min": 1, "max": 5 },
  "defaultScale": "maturity",
  "answerScales": {
    "maturity": [
      { "label": "No policy or process in place", "score": 1 },
      { "label": "Informal or ad hoc approach", "score": 2 },
      { "label": "Formal policy, partially implemented", "score": 3 },
      { "label": "Implemented, monitored and measured", "score": 4 },
      { "label": "Independently verified, targets on track", "score": 5 }
    ]
  },
  "riskBands": [
    { "max": 1.5, "label": "Low", "action": "Monitor. No engagement required this cycle." },
    { "max": 2.5, "label": "Moderate", "action": "Annual review. Targeted questions at next cycle." },
    { "max": 3.5, "label": "High", "action": "Engagement plan required within 90 days." },
    { "max": 5.01, "label": "Severe", "action": "Escalate to investment committee. Consider conditions or exclusion." }
  ],
