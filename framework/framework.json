      "questions": [
        {
          "id": "ghg-1",
          "text": "Does the company have a climate policy and a board-level owner for emissions?",
          "weight": 1,
          "ref": "ISSB S2 / SASB"
        },
        {
          "id": "ghg-2",
          "text": "Are Scope 1 and 2 emissions measured, and is Scope 3 assessed for material categories?",
          "weight": 1.5,
          "ref": "GHG Protocol"
        },
        {
          "id": "ghg-3",
          "text": "Are emissions targets set with a baseline year, and progress independently verified?",
          "weight": 2,
          "ref": "SBTi criteria"
        },
        {
